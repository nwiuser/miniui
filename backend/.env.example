# Environment used when running the backend directly on the host
# (uvicorn / pytest). Docker Compose sets its own defaults in docker-compose.yml.

# --- Database (required) ---
DATABASE_URL=postgresql://apexos_user:apexos_pass@localhost:5432/apexos

# --- HTTP ---
# Comma-separated. "*" disables host checking (development only).
ALLOWED_HOSTS=*
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Session cookie ---
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# --- Application metadata cache ---
METADATA_CACHE_TTL=5.0
METADATA_CACHE_MAX_ENTRIES=64

# --- First administrator (optional, used by scripts/init_db.py) ---
# BOOTSTRAP_ADMIN_USERNAME=ADMIN
# BOOTSTRAP_ADMIN_PASSWORD=Changeme123!
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
