# Variables read by docker-compose.yml (copy to ".env" and edit).
# Values shown are the compose defaults.

# --- PostgreSQL container ---
POSTGRES_DB=apexos
POSTGRES_USER=apexos_user
POSTGRES_PASSWORD=apexos_pass

# --- Backend (host is the compose service name "postgres") ---
DATABASE_URL=postgresql://apexos_user:apexos_pass@postgres:5432/apexos
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*
COOKIE_SECURE=false
METADATA_CACHE_TTL=5.0
METADATA_CACHE_MAX_ENTRIES=64

# --- Frontend (host is the compose service name "backend") ---
BACKEND_URL=http://backend:8000

# --- First administrator (optional; seeded once on backend startup) ---
# BOOTSTRAP_ADMIN_USERNAME=ADMIN
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
